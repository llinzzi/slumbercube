#!/bin/zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
CACHE_DIR="${TMPDIR:-/tmp}/slumbercube-ble-inspector"
BINARY="$CACHE_DIR/ble-inspector"
SOURCE="$SCRIPT_DIR/ble_inspector.swift"

mkdir -p "$CACHE_DIR"
if [[ ! -x "$BINARY" || "$SOURCE" -nt "$BINARY" ]]; then
    echo "首次运行：正在编译 BLE Inspector…" >&2
    xcrun swiftc "$SOURCE" -framework CoreBluetooth -o "$BINARY"
fi

exec "$BINARY" "$@"
