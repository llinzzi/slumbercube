menu "SlumberCube Configuration"

    menu "WiFi Configuration"
        config WIFI_SSID
            string "WiFi SSID"
            default "Happy"
        config WIFI_PASS
            string "WiFi Password"
            default "ping8275"
    endmenu

    menu "Night Mode Configuration"
        config NIGHT_START_HOUR
            int "Night mode start hour (0-23)"
            range 0 23
            default 23
        config NIGHT_START_MINUTE
            int "Night mode start minute (0-59)"
            range 0 59
            default 0
        config NIGHT_END_HOUR
            int "Night mode end hour (0-23)"
            range 0 23
            default 6
    endmenu

    menu "Sleep Configuration"
        config ACTIVE_DURATION_SECS
            int "Active duration before deep sleep (seconds)"
            default 1800
        config WAKEUP_GPIO
            int "Wakeup GPIO number"
            default 3
        config WAKEUP_HOUR
            int "Auto-wakeup hour (0-23)"
            range 0 23
            default 7
        config WAKEUP_MINUTE
            int "Auto-wakeup minute (0-59)"
            range 0 59
            default 50
    endmenu

    menu "GPIO Pin Configuration"
        config PIN_MOSI
            int "SPI MOSI pin"
            default 10
        config PIN_CLK
            int "SPI CLK pin"
            default 7
        config PIN_CS
            int "SPI CS pin (-1 = grounded)"
            default -1
        config PIN_DC
            int "SPI DC pin"
            default 8
        config PIN_RST
            int "SPI RST pin"
            default 20
        config PIN_NS4168_CTRL
            int "NS4168 amplifier control pin"
            default 2
        config PIN_I2S_SDIN
            int "I2S SDIN pin (NS4168 data)"
            default 4
        config PIN_I2S_SCLK
            int "I2S SCLK pin (NS4168 bit clock)"
            default 5
        config PIN_I2S_LROUT
            int "I2S LROUT pin (NS4168 word select)"
            default 6
        config BUTTON_GPIO
            int "Button GPIO number"
            default 3
    endmenu

    menu "Audio Configuration"
        config AUDIO_ENABLE
            bool "Enable audio playback on wakeup"
            default y
        config AUDIO_VOLUME_PCT
            int "Audio volume (0-100)"
            range 0 100
            default 10
    endmenu

    menu "PCF85063 RTC Configuration"
        config PCF85063_ENABLE
            bool "Enable PCF85063 external RTC"
            default y
            help
              PCF85063ATT/AJ external RTC chip on the I2C bus.
              Provides accurate timekeeping during deep sleep so the
              ESP32-C3 does not need to keep its internal RTC running.
        config PCF85063_I2C_ADDR
            hex "PCF85063 I2C address (7-bit)"
            default 0x51
            range 0x00 0x7F
        config PCF85063_I2C_SDA_GPIO
            int "I2C SDA GPIO (shared with SHTC3)"
            default 21
        config PCF85063_I2C_SCL_GPIO
            int "I2C SCL GPIO (shared with SHTC3)"
            default 9
        config PCF85063_I2C_FREQ_HZ
            int "I2C bus frequency (Hz)"
            default 400000
        config PCF85063_INT_GPIO
            int "PCF85063 INT# GPIO (RTC alarm/second interrupt)"
            default 0
    endmenu

endmenu
