# Use internal 150kHz RC oscillator (no external 32kHz crystal on this board)
CONFIG_RTC_CLK_SRC_INT_RC=y

# Use custom 1800K factory partition (binary too large for standard 1500K large partition)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Audio player
CONFIG_AUDIO_ENABLE=y
CONFIG_AUDIO_PLAYER_ENABLE_MP3=y
CONFIG_AUDIO_PLAYER_ENABLE_WAV=y
CONFIG_AUDIO_PLAYER_ENABLE_HTTP_STREAM=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# CONFIG_LV_FONT_MONTSERRAT_14 is not set

# BLE central used to send the blinkwh CH582 night-light's FFE1=0x01 command
# after a successful audio start. Keep only the roles/services we need.
CONFIG_BLE_LIGHT_DEVICE_ADDRESS="0c:3d:5e:a6:63:c0"
CONFIG_BLE_LIGHT_CONNECT_TIMEOUT_MS=10000
# BT/NimBLE are enabled explicitly with the night-light configuration. Keeping
# this file free of a global BT enable means a no-light build has no Bluetooth
# stack at all.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_SERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_SM_SC=n
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=3152
# One short GATT write needs only a handful of HCI/mbuf entries.  The
# NimBLE defaults reserve enough RAM for general-purpose multi-peer use and
# leave insufficient contiguous heap for the MP3 decoder on ESP32-C3.
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_NIMBLE_DTM_MODE_TEST=n
CONFIG_BT_NIMBLE_SM_SIGN_CNT=n
CONFIG_BT_NIMBLE_CPFD_CAFD=n
CONFIG_BT_NIMBLE_RECONFIG_MTU=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=1
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_BLE_ADV_REPORT_DISCARD_THRSHOLD=1
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=10

# Night mode: 23:00 → 06:00 (crosses midnight). Pinned here so the
# default in Kconfig.projbuild doesn't drift on rebuilds.
CONFIG_NIGHT_START_HOUR=22
CONFIG_NIGHT_START_MINUTE=0

# ESP32-C3-MINI-1-N4 has 4MB flash; partitions.csv needs the full
# 4032K factory partition, so override the IDF default of 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Disable HTTPS in esp_http_client — not used, saves heap for audio streaming
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set

# Enable LVGL QR code widget (used by config_screen)
CONFIG_LV_USE_QRCODE=y

# Frame pointer disabled — saves a few KB of flash + slightly faster ISR
# entry. Means watchdog/panic only dumps PC/RA/SP (no call chain).
# Re-enable if a future crash needs deeper forensics.
# CONFIG_ESP_SYSTEM_USE_FRAME_POINTER is not set

# Reduce LWIP footprint. Must be ≥ 3 (HTTP server internal) + 3 (open)
# = 6 minimum for provisioning HTTP server to start.
CONFIG_LWIP_MAX_SOCKETS=7
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8

# Wi-Fi defaults target high throughput and reserve too much DRAM when BLE,
# LVGL and the MP3 decoder run together. Internet radio needs only one modest
# TCP stream; these values retain AMPDU while recovering contiguous heap.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6

# Memory optimizations
CONFIG_LV_MEM_SIZE_KILOBYTES=16

# Propagate DHCP-allocated DNS servers into lwIP so SNTP / DNS-using
# code can resolve hostnames (e.g. ntp.aliyun.com). Without this, lwIP's
# default DNS server list is empty and every SNTP server-name lookup
# silently fails. Critical for any feature that uses hostnames.
CONFIG_LWIP_DNS_SETSERVER_WITH_NETIF=y

# mbedTLS: HTTPS is disabled (see above), so shrink TLS buffers to minimum.
# SSL_IN/OUT buffers are allocated dynamically only when needed; with
# HTTPS fully disabled they stay at 0 heap cost. Pinning a small value
# prevents the Kconfig default (2048) from drifting back on rebuilds.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=512
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=512
# Reduce certificate bundle — no HTTPS connections are made
# Certificate bundle: keep IDF default — setting to 0 breaks the build
# (x509_crt_bundle generator requires at least a placeholder cert).
# HTTPS is disabled so the bundle is never used at runtime.
